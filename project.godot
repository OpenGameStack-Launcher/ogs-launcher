; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="OGS Launcher"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
run/low_processor_mode=true
boot_splash/image="res://Images/logo.png"
config/icon="res://Images/logo.png"
config/windows_native_icon="res://Images/logo.ico"

[display]

window/size/viewport_width=1024
window/size/viewport_height=700
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/energy_saving/keep_screen_on=false
window/subwindows/embed_subwindows=false

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.117647, 0.117647, 0.117647, 1)
